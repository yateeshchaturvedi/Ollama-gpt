# Production environment example
# Copy to .env.production and fill in values

# Pin images you have tested and approved
OLLAMA_IMAGE=ollama/ollama:<pin>
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:<pin>
AI_AGENT_IMAGE=ollama-gpt/ai-agent:<pin>

OLLAMA_PORT=11434
OPENWEBUI_PORT=3000
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_RETRIES=3
MAX_TOOL_STEPS=5
MAX_HISTORY=12
LOG_LEVEL=INFO
SAFE_WORKSPACE_ROOT=/workspace
ALLOWED_SHELL_PREFIXES=ls,dir,pwd,echo,cat,type
TOOL_RATE_LIMIT_COUNT=30
TOOL_RATE_LIMIT_WINDOW_SECONDS=60
TOOL_AUDIT_LOG_PATH=/app/logs/tool_audit.log
DANGEROUS_ACTIONS_REQUIRE_CONFIRMATION=true
DANGEROUS_CONFIRMATION_TOKEN=<replace-with-long-random-token>

# Optional: only set if needed by your workflows.
HF_TOKEN=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_MONITOR_REPOS=
GITHUB_ALERT_CHANNEL=
GITHUB_ALERT_POLL_SECONDS=120
GITHUB_PR_MONITOR_REPOS=
GITHUB_PR_ALERT_CHANNEL=
GITHUB_PR_POLL_SECONDS=180
GITHUB_DIGEST_REPOS=
GITHUB_DIGEST_CHANNEL=
GITHUB_DIGEST_HOUR=9
GITHUB_DIGEST_MINUTE=0
GITHUB_TZ_OFFSET_MINUTES=330
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_MONITOR_JOBS=
JENKINS_ALERT_CHANNEL=
JENKINS_POLL_SECONDS=180
AZDO_ORG_URL=
AZDO_PAT=
AZDO_MONITOR_PIPELINES=
AZDO_ALERT_CHANNEL=
AZDO_POLL_SECONDS=180
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_MONITOR_PROJECTS=
GITLAB_ALERT_CHANNEL=
GITLAB_POLL_SECONDS=180
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNEL=
SLACK_REQUIRE_MENTION=true
MAX_SLACK_REPLY_CHARS=38000
MONITOR_STATE_PATH=/workspace/monitor_state.json
