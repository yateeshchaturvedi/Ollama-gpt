# LLM Configuration
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Core settings
MAX_TOOL_STEPS=5
MAX_HISTORY=12
LOG_LEVEL=INFO
SAFE_WORKSPACE_ROOT=/workspace

# Security
ALLOWED_SHELL_PREFIXES=ls,dir,pwd,echo,cat,type
TOOL_RATE_LIMIT_COUNT=60
TOOL_RATE_LIMIT_WINDOW_SECONDS=60
TOOL_AUDIT_LOG_PATH=logs/tool_audit.log
DANGEROUS_ACTIONS_REQUIRE_CONFIRMATION=true
DANGEROUS_CONFIRMATION_TOKEN=CONFIRM

# GitHub configuration (Global fallback)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_MONITOR_REPOS=
GITHUB_ALERT_CHANNEL=
GITHUB_ALERT_POLL_SECONDS=120
GITHUB_PR_MONITOR_REPOS=
GITHUB_PR_ALERT_CHANNEL=
GITHUB_PR_POLL_SECONDS=180
GITHUB_DIGEST_REPOS=
GITHUB_DIGEST_CHANNEL=
GITHUB_DIGEST_HOUR=9
GITHUB_DIGEST_MINUTE=0
GITHUB_TZ_OFFSET_MINUTES=330

# Jenkins configuration (Global fallback)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Azure DevOps configuration (Global fallback)
AZDO_ORG_URL=
AZDO_PAT=

# GitLab configuration (Global fallback)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Slack Integrations
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNEL=
SLACK_REQUIRE_MENTION=true
MAX_SLACK_REPLY_CHARS=38000
MONITOR_STATE_PATH=/workspace/monitor_state.json

# Database & Auth
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devops_agent
DB_ENCRYPTION_KEY=my_secure_encryption_key_32_chars!
JWT_SECRET_KEY=my_jwt_secret_key_change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

